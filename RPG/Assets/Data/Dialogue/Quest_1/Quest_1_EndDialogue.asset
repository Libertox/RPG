  m_Name: Quest_1_EndDialogue
  m_EditorClassIdentifier: 
  Dialogues:
  - Content: "You\u2019ve returned! And with all the herbs! Truly remarkable."
    DialogueActor: {fileID: 11400000, guid: 70e9471fe72f4c9438024ab1165582cc, type: 2}
  - Content: Thanks to you, the potion will protect the forest and its creatures.
    DialogueActor: {fileID: 11400000, guid: 70e9471fe72f4c9438024ab1165582cc, type: 2}
  - Content: Please, accept this reward as a token of my gratitude.
    DialogueActor: {fileID: 11400000, guid: 70e9471fe72f4c9438024ab1165582cc, type: 2}
  - Content: Glad I could be of service.
    DialogueActor: {fileID: 11400000, guid: d91ea15a4a4624644b88258d397d7967, type: 2}
  - Content: Safe travels, brave one. The forest will always remember your deeds.
    DialogueActor: {fileID: 11400000, guid: 70e9471fe72f4c9438024ab1165582cc, type: 2}
