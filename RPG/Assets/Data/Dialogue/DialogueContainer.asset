--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 533e63046846d0442881d60099cfbcd7, type: 3}
  m_Name: DialogueContainer
  m_EditorClassIdentifier: 
  Dialogues:
  - Content: "Ah\u2026 traveler. The forest knows your scent now. You\u2019ve walked
      paths few dare tread."
    DialogueActor: {fileID: 11400000, guid: 70e9471fe72f4c9438024ab1165582cc, type: 2}
  - Content: "What\u2019s troubling you, Elder"
    DialogueActor: {fileID: 11400000, guid: d91ea15a4a4624644b88258d397d7967, type: 2}
  - Content: "The woods whisper of decay. The Heartroot Tree \u2014 our guardian
      \u2014 bleeds black sap. Something dark has taken root beneath it"
    DialogueActor: {fileID: 11400000, guid: 70e9471fe72f4c9438024ab1165582cc, type: 2}
  - Content: Sounds like your tree needs a gardener.
    DialogueActor: {fileID: 11400000, guid: d91ea15a4a4624644b88258d397d7967, type: 2}
  - Content: If only pruning shadows were so simple.
    DialogueActor: {fileID: 11400000, guid: 70e9471fe72f4c9438024ab1165582cc, type: 2}
  - Content: "Three runestones seal the corruption below. They were stolen by the
      Hollow Ones, spirits bound to rot and ruin. Find the stones. Return them. Or
      the forest \u2014 and all within \u2014 will wither"
    DialogueActor: {fileID: 11400000, guid: 70e9471fe72f4c9438024ab1165582cc, type: 2}
  - Content: What do I get for risking my neck
    DialogueActor: {fileID: 11400000, guid: d91ea15a4a4624644b88258d397d7967, type: 2}
  - Content: "Life itself, child. But if that\u2019s too abstract\u2026 there\u2019s
      gold in the roots, and secrets the trees whisper only to those who listen"
    DialogueActor: {fileID: 11400000, guid: 70e9471fe72f4c9438024ab1165582cc, type: 2}
